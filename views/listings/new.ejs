<% layout("/layouts/boilerplate") %>

    
    <div class="row mt-3">
        <div class="col-8 offset-2">
            <br>
            <h2>Add New Listing</h2>
        
    <form action="/listings" method="post" class="needs-validation" novalidate enctype="multipart/form-data">
        <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input type="text" name="listing[title]" class="form-control" required>
            <div class="valid-feedback">Title looks great!</div>
            <div class="invalid-feedback">Please enter a valid title</div>
        </div>
        <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea name="listing[description]" class="form-control" required></textarea>
            <div class="valid-feedback">Amazing description!</div>
            <div class="invalid-feedback">Description missing </div>
        </div>
        <!-- <div class="mb-3">
            <label for="imageUrl" class="form-label">Image Link</label>
            <input type="text" name="listing[image][url]" class="form-control" >
        </div> -->
        <div class="mb-3">
            <label for="image" class="form-label">Upload Listing Image</label>
            <input type="file" name="listing[image]" class="form-control" required>
        </div>
        <!-- <div class="mb-3">
            <label for="imageFilename" class="form-label">Filename</label>
            <input type="text" name="listing[image][filename]" class="form-control" >
        </div> -->
        <div class="row">
            <div class="mb-3 col-md-4">
                <label for="price" class="form-label">Price</label>
                <input name="listing[price]" class="form-control" required>
                <div class="invalid-feedback">Enter a valid Price</div>
            </div>
            <div class="mb-3 col-md-8">
                <label for="country" class="form-label">Country</label>
                <input type="text" name="listing[country]" class="form-control" required>
                <div class="invalid-feedback">Enter valid country name</div>
            </div>
        </div>
        
        <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input type="text" name="listing[location]" class="form-control" required>
            <div class="invalid-feedback">Enter a valid location</div>
        </div>
       
        <!-- <input type="text" name="listing[title]" placeholder="title"><br><br>
        <textarea name="listing[description]" placeholder="Enter Description"></textarea><br><br>
        <input type="text" name="listing[image][url]" placeholder="Image Url/link"><br><br>
        <input type="text" name="listing[image][filename]" placeholder="filename"><br><br>
        <input type="number" name="listing[price]" placeholder="price"><br><br>
        <input type="text" name="listing[location]" placeholder="location"><br><br>
        <input type="text" name="listing[country]" placeholder="country"><br><br><br> -->
        
        
        <button class="btn btn-dark mb-3 add-btn">Add Listing</button>
        

    </form>
</div>
</div>

